# Prefer Formspree (simplest free path) OR Supabase — set one path.

# --- Formspree (recommended starter) ---
# Create a form at https://formspree.io → copy the form id from https://formspree.io/f/XXXX
FORMSPREE_FORM_ID=

# --- Supabase (free tier alternative) ---
# Project URL + service role key (server-only; never expose in the browser).
# Create a table (default name: rsvps) — see README for SQL.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override (default: rsvps)
SUPABASE_RSVP_TABLE=rsvps
